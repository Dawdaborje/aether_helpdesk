<page route="/helpdesk/email/mailboxes/{id}" title="Mailbox" menu="false" model="hd_mailbox" roles="helpdesk.hd_manager,helpdesk.hd_admin">
  <view type="form" source="get_mailbox" function="update_mailbox" submit="Save">
    <header>
      <button label="New secret" function="rotate_mailbox_secret" confirm="Make a new secret? The old one stops working at once."/>
    </header>
    <group title="Mailbox" cols="2">
      <field name="address" label="Address" readonly="true"/>
      <field name="name" label="Name"/>
      <field name="team" label="Send to team" fieldType="many2one" entity="teams"/>
      <field name="ticket_type" label="Kind of ticket" fieldType="many2one" entity="types"/>
      <field name="priority" label="Priority" fieldType="many2one" entity="priorities"/>
      <field name="active" label="Active" fieldType="boolean"/>
      <field name="notes" label="Notes" fieldType="text" colspan="2"/>
    </group>
    <group title="Hand mail to us" cols="1">
      <field name="secret" label="Secret" readonly="true" help="Post each message to /api/plugins/helpdesk_email/email_inbound with this secret in a 'secret' field (or an X-Aether-Secret header in the message)."/>
    </group>
  </view>
</page>
