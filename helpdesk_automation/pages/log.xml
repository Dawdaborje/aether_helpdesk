<page route="/helpdesk/automation/log" title="Run log" model="hd_rule_run" icon="history" sort="91" roles="helpdesk.hd_agent,helpdesk.hd_manager,helpdesk.hd_admin">
  <view type="list" source="list_rule_runs">
    <columns>
      <column field="at" label="When" fieldType="datetime"/>
      <column field="rule" label="Rule"/>
      <column field="ticket_reference" label="Ticket"/>
      <column field="trigger" label="Because" fieldType="badge"/>
      <column field="ok" label="Worked" fieldType="boolean"/>
      <column field="summary" label="What happened"/>
    </columns>
    <empty title="Nothing has run" description="Every rule run is recorded."/>
  </view>
</page>
