<page route="/helpdesk/tickets/{id}/article" title="Send an article" menu="false" model="hd_kb_article" roles="helpdesk.hd_agent,helpdesk.hd_manager,helpdesk.hd_admin">
  <view type="form" function="reply_with_article" submit="Send" success="Sent" redirect="/helpdesk/tickets/{id}">
    <group title="Answer with an article" cols="2">
      <field name="article" label="Article" fieldType="many2one" source="published_articles" optionLabel="title" entity="articles" required="true"/>
      <field name="set_state" label="Afterwards" fieldType="selection" options="pending, on_hold, resolved"/>
      <field name="note" label="Say something first" fieldType="text" colspan="2"/>
    </group>
  </view>
</page>
